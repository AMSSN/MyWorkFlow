<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="22.05.0.0">
<procedure name="main">
<interface/>
<body>
<l>read_image (ImageOut, 'C:/Users/M/Desktop/02 尺寸/1#/IMG_20260415141706.jpg')</l>
<l>read_image (ImageIn, 'C:/Users/M/Desktop/02 尺寸/1#/IMG_20260415141727.jpg')</l>
<c></c>
<l>* read_image (ImageOut, 'C:/Users/M/Desktop/02 尺寸/2#/IMG_20260415142000.jpg')</l>
<l>* read_image (ImageIn, 'C:/Users/M/Desktop/02 尺寸/2#/IMG_20260415141942.jpg')</l>
<c></c>
<c></c>
<l>get_image_size (ImageIn, Width, Height)</l>
<l>rgb1_to_gray (ImageOut, GrayImageOut)</l>
<l>rgb1_to_gray (ImageIn, GrayImageIn)</l>
<c>*外径</c>
<l>mult_image (GrayImageOut, GrayImageOut, ImageResultOut, 0.015, 0)</l>
<l>threshold (ImageResultOut, RegionOut, 0, 200)</l>
<l>connection (RegionOut, ConnectedRegionsOut)</l>
<c>* 1#</c>
<l>select_shape (ConnectedRegionsOut, SelectedRegionsOut, 'area', 'and', 500000, 600000)</l>
<c>* 2#</c>
<l>* select_shape (ConnectedRegionsOut, SelectedRegionsOut, 'area', 'and', 4000000, 6000000)</l>
<l>opening_circle (SelectedRegionsOut, SelectedRegionsOut, 7)</l>
<l>smallest_circle (SelectedRegionsOut, RowOut, ColumnOut, RadiusOut)</l>
<c></c>
<c>* 1. 创建计量模型</c>
<l>create_metrology_model (MetrologyHandleOut)</l>
<c>* 2. （可选）设置图像尺寸，有助于模型初始化</c>
<l>set_metrology_model_image_size (MetrologyHandleOut, Width, Height)</l>
<c>* 3. 添加圆形测量对象</c>
<l>add_metrology_object_circle_measure (MetrologyHandleOut, RowOut, ColumnOut, RadiusOut, 20, 5, 1, 30, [], [], Index)</l>
<c>* 4. （可选）设置高级参数，例如只寻找从暗到亮的边缘</c>
<l>set_metrology_object_param (MetrologyHandleOut, Index, 'measure_transition', 'positive')</l>
<c>* 5. 应用模型到图像进行测量</c>
<l>apply_metrology_model (ImageOut, MetrologyHandleOut)</l>
<c>* 6. 获取结果</c>
<c>* 获取圆的几何参数</c>
<l>get_metrology_object_result (MetrologyHandleOut, Index, 'all', 'result_type', 'all_param', CircleParameters)</l>
<c>* 获取圆的轮廓用于显示</c>
<l>get_metrology_object_result_contour (ContourOut, MetrologyHandleOut, Index, 'all', 1.5)</l>
<c>* Parameter的值（中心坐标和半径）</c>
<l>* get_metrology_object_result (MetrologyHandleOut, 0, 'all', 'result_type', 'all_param', Parameter)</l>
<c>* 7. 显示结果</c>
<l>* dev_display (Image)</l>
<l>* dev_set_color ('green')</l>
<l>* dev_display (Contour)</l>
<c>* 8. 清理模型</c>
<l>clear_metrology_model (MetrologyHandleOut)</l>
<l>gen_region_contour_xld (ContourOut, RegionOut, 'filled')</l>
<l>* dilation_circle (RegionOut, RegionDilationOut, 3)</l>
<l>erosion_circle (RegionOut, RegionErosionOut, 1)</l>
<l>smallest_circle (RegionErosionOut, RowOut, ColumnOut, RadiusOut)</l>
<l>outer_diameter:=RadiusOut*2</l>
<c></c>
<c></c>
<c></c>
<c></c>
<c>*内径</c>
<l>mult_image (GrayImageIn, GrayImageIn, ImageResultIn, 0.015, 0)</l>
<l>threshold (ImageResultIn, RegionIn, 0, 50)</l>
<l>dilation_circle (RegionIn, RegionIn, 1)</l>
<l>connection (RegionIn, ConnectedRegionsIn)</l>
<l>select_shape (ConnectedRegionsIn, SelectedRegionsIn, 'area', 'and', 4000000, 5000000)</l>
<c>* 2#</c>
<l>* opening_circle (SelectedRegionsIn, SelectedRegionsIn, 50)</l>
<l>* closing_circle (SelectedRegionsIn, SelectedRegionsIn, 7)</l>
<l>* inner_circle (SelectedRegionsIn, RowIn, ColumnIn, RadiusIn)</l>
<l>* RadiusIn:=RadiusIn+30</l>
<l>* gen_circle (CCCCircle, RowIn, ColumnIn, RadiusIn)</l>
<c>* 1#</c>
<l>smallest_circle (SelectedRegionsIn, RowIn, ColumnIn, RadiusIn)</l>
<c></c>
<c>*卡尺测量</c>
<l>create_metrology_model (MetrologyHandleIn)</l>
<l>set_metrology_model_image_size (MetrologyHandleIn, Width, Height)</l>
<c>* 3. 添加圆形测量对象</c>
<l>add_metrology_object_circle_measure (MetrologyHandleIn, RowIn, ColumnIn, RadiusIn, 20, 5, 1, 30, [], [], Index)</l>
<c>* 4. （可选）设置高级参数，例如只寻找从暗到亮的边缘</c>
<l>set_metrology_object_param (MetrologyHandleIn, Index, 'measure_transition', 'positive')</l>
<c>* 5. 应用模型到图像进行测量</c>
<l>apply_metrology_model (ImageIn, MetrologyHandleIn)</l>
<c>* 6. 获取结果</c>
<c>* 获取圆的几何参数</c>
<l>get_metrology_object_result (MetrologyHandleIn, Index, 'all', 'result_type', 'all_param', CircleParameters)</l>
<c>* 获取圆的轮廓用于显示</c>
<l>get_metrology_object_result_contour (ContourIn, MetrologyHandleIn, Index, 'all', 1.5)</l>
<c>* Parameter的值（中心坐标和半径）</c>
<l>* get_metrology_object_result (MetrologyHandleIn, 0, 'all', 'result_type', 'all_param', Parameter)</l>
<c>* 7. 显示结果</c>
<l>* dev_display (Image)</l>
<l>* dev_set_color ('green')</l>
<l>* dev_display (Contour)</l>
<c>* 8. 清理模型</c>
<l>clear_metrology_model (MetrologyHandleIn)</l>
<l>gen_region_contour_xld (ContourIn, RegionIn, 'filled')</l>
<l>* dilation_circle (RegionIn, RegionDilationIn, 3)</l>
<l>erosion_circle (RegionIn, RegionErosionIn, 1)</l>
<l>smallest_circle (RegionErosionIn, RowIn, ColumnIn, RadiusIn)</l>
<l>inner_diameter:=RadiusIn*2</l>
<c></c>
<c></c>
<l>paint_region (RegionErosionOut, ImageOut, PaintResultOut, [255,0,0], 'margin')</l>
<l>paint_region (RegionErosionIn, ImageIn, PaintResultIn, [255,0,0], 'margin')</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
